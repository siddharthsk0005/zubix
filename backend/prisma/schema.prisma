generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  iconName     String   @default("category")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brands       Brand[]
}

model Brand {
  id               String         @id @default(uuid())
  name             String
  tagline          String
  bio              String
  logoUrl          String
  showcaseImages   String[]
  websiteUrl       String
  socialLinks      Json           @default("{}")
  contactEmail     String
  contactPhone     String
  sessionCreatedBy String         @default("Zubix Curators")
  isApproved       Boolean        @default(false)
  isPhysicalStore  Boolean        @default(false)
  storeType        String         @default("online_d2c") // "online_d2c" or "local_store"
  city             String?
  area             String?
  address          String?
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String?
  timings          String?        @default("10:00 AM - 9:30 PM")
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sessions         Session[]
  vouchers         VoucherClaim[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Session {
  id                     String         @id @default(uuid())
  title                  String         @default("Generative Sessions")
  brandId                String
  brand                  Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionCreatedBy       String
  waitingDurationSeconds Int            @default(30)
  discountValue          String
  couponCode             String
  status                 String         @default("active") // upcoming, active, completed
  totalVouchersPool      Int            @default(100)
  claimedVouchersCount   Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  claims                 VoucherClaim[]
}

model VoucherClaim {
  id            String   @id @default(uuid())
  code          String
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  discountValue String
  brandWebsite  String
  categoryName  String
  claimedAt     DateTime @default(now())
  expiresAt     DateTime
  isRedeemed    Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  terms         String?
}

model User {
  id                String         @id @default(uuid())
  phone             String?        @unique
  email             String?        @unique
  name              String?
  country           String?
  state             String?
  district          String?
  role              String         @default("consumer") // consumer, brand, admin
  avatarUrl         String?
  isProfileComplete Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vouchers          VoucherClaim[]
}
