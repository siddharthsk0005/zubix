generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  iconName     String   @default("category")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  scope        String   @default("brand") // "brand" or "nearby"
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brands       Brand[]
}

model Brand {
  id               String         @id @default(uuid())
  name             String
  tagline          String
  bio              String
  logoUrl          String
  showcaseImages   String[]
  websiteUrl       String
  socialLinks      Json           @default("{}")
  contactEmail     String
  contactPhone     String
  sessionCreatedBy String         @default("Zubix Curators")
  isApproved       Boolean        @default(false)
  isPhysicalStore  Boolean        @default(false)
  storeType        String         @default("online_d2c") // "online_d2c" or "local_store"
  city             String?
  area             String?
  address          String?
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String?
  timings          String?        @default("10:00 AM - 9:30 PM")
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sessions         Session[]
  vouchers         VoucherClaim[]
  media            BrandMedia[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Ordered images/videos a brand uploads. Customers see them in `position` order on the Brands page.
model BrandMedia {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind        String   // "image" or "video"
  url         String
  storagePath String
  mimeType    String
  sizeBytes   Int
  position    Int
  createdAt   DateTime @default(now())

  @@index([brandId, position])
}

model Session {
  id                     String         @id @default(uuid())
  title                  String         @default("Generative Sessions")
  brandId                String
  brand                  Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionCreatedBy       String
  waitingDurationSeconds Int            @default(30)
  discountValue          String
  couponCode             String
  status                 String         @default("active") // upcoming, active, completed
  totalVouchersPool      Int            @default(100)
  claimedVouchersCount   Int            @default(0)
  // When allotted vouchers move from the customer's Pool to My Vouchers. Set by admin.
  poolReleaseAt          DateTime?
  // Coupon tiers [{key, label, slots, discountPct}] the admin allots from. Index is the tier key.
  couponTiers            Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  claims                 VoucherClaim[]
  participations         SessionParticipation[]
}

// A customer's place in a session's waiting pool. Status: waiting, pooled, allotted.
model SessionParticipation {
  id          String    @id @default(uuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("waiting")
  joinedAt    DateTime  @default(now())
  acceptAt    DateTime
  // Coupon tier the admin allotted this user to. Null until allotted.
  tierKey     String?
  allottedAt  DateTime?
  // Set when the customer presses "Okay" on the pool acceptance notice.
  acknowledgedAt DateTime?
  claimId     String?   @unique

  @@unique([sessionId, userId])
  @@index([userId])
}

model VoucherClaim {
  id            String   @id @default(uuid())
  code          String
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  discountValue String
  brandWebsite  String
  categoryName  String
  claimedAt     DateTime @default(now())
  expiresAt     DateTime
  isRedeemed    Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  terms         String?
  // Vouchers stay in the customer's Pool until this time. Null means already released.
  releaseAt     DateTime?
}

model BrandRegistration {
  id              String    @id @default(uuid())
  brandName       String
  ownerName       String
  ownerPhone      String
  ownerEmail      String
  passwordHash    String    // scrypt hash, never returned by the API
  brandType       String    @default("online_d2c") // "online_d2c" or "local_store"
  websiteUrl      String?
  instagramUrl    String?
  socialLinks     Json      @default("{}") // keys: instagram, youtube, linkedin, facebook, call, whatsapp
  description     String?
  categoryId      String
  city            String?
  area            String?
  address         String?
  operatingHours  String?
  status          String    @default("pending") // pending, approved, rejected
  rejectionReason String?
  adminNotes      String?
  appliedAt       DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
}

model SessionRequest {
  id              String    @id @default(uuid())
  brandId         String
  brandName       String
  brandType       String    @default("online_d2c")
  createdBy       String?   // name of the person who created this session
  requestedDate   DateTime
  couponTiers     Json
  additionalNotes String?
  status          String    @default("pending_approval") // pending_approval, approved, rejected, dates_proposed, brand_confirmed
  rejectionReason String?
  proposedDates   DateTime[]
  confirmedDate   DateTime?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
}

model User {
  id                String         @id @default(uuid())
  phone             String?        @unique
  email             String?        @unique
  name              String?
  country           String?
  state             String?
  district          String?
  role              String         @default("consumer") // consumer, brand, admin
  passwordHash      String?        // set only for admin accounts (created via create-admin script)
  avatarUrl         String?
  isProfileComplete Boolean        @default(false)
  // Consumer sign-ups start as "pending" and need admin approval before login. Existing users stay "approved".
  approvalStatus    String         @default("approved") // draft, pending, approved, rejected
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vouchers          VoucherClaim[]
  participations    SessionParticipation[]
}
